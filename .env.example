# Copy to .env (git-ignored) before running docker compose: cp .env.example .env
# Values below are local-development placeholders, not secrets. Never commit .env.

# development | test | production. Required by the API (no default).
ENV=development

# Postgres container credentials (used by `docker compose`).
# Keep the password URL-safe: it is embedded in the API's DATABASE_URL.
POSTGRES_USER=apm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=apm

# Host ports, bound to 127.0.0.1 only.
DB_HOST_PORT=5435
API_HOST_PORT=8001

# Used ONLY when running the API on the host (uv), outside Docker. It points to the
# published db port; keep user, password and database in sync with the values above.
# Inside docker compose the API receives its own DATABASE_URL (host `db`), built from POSTGRES_*.
DATABASE_URL=postgresql+psycopg://apm:change-me@127.0.0.1:5435/apm
