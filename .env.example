# Conexão da aplicação (papel SEM superusuário, sujeito a Row Level Security)
DATABASE_URL=postgres://apm_app:apm_app@localhost:5432/apm
# Conexão usada apenas para migrações (dono das tabelas)
DATABASE_ADMIN_URL=postgres://apm:apm@localhost:5432/apm

# Chave mestra para cifrar credenciais Pix (32 bytes em base64). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# URL pública do sistema (usada para registrar o webhook no banco)
APP_URL=https://apm.exemplo.com.br
