# Copy to .env (git-ignored) before running docker compose: cp .env.example .env
# Values below are local-development placeholders, not secrets. Never commit .env.

# development | test | production. Required by the API (no default).
ENV=development

# Postgres container credentials (used by `docker compose`).
# The password must be URL-safe (no @ : / ? # or spaces): compose embeds it in the API's DATABASE_URL
# and the API refuses to start when it cannot read the URL safely. Generate one with: openssl rand -hex 24
POSTGRES_USER=apm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=apm

# Password of the `apm_app` Postgres role, the only identity the API connects as (no superuser,
# no BYPASSRLS, not the table owner). The `migrate` service creates the role with this password.
# Same URL-safe rule as above; use a different value from POSTGRES_PASSWORD.
# Rebuilding an existing preview? Add APP_DB_PASSWORD to its env-file first.
APP_DB_PASSWORD=change-me-app

# Key for the CSRF token and for the rate-limit digests (e-mail and IP are stored only as HMACs).
# At least 32 characters, random: openssl rand -hex 32. Required by the API.
AUTH_SECRET=change-me-generate-one-with-openssl-rand-hex-32

# Cookies. false ONLY in development: WebKit (Safari and the Maestri portal) does not accept a
# Secure cookie over plain http, and false also drops the __Host- prefix of the cookie names. The API
# refuses to start with ENV=production unless this is true.
COOKIE_SECURE=false
# The origins the site is served from, comma-separated (required in production, https only). Every
# state-changing request must come from one of them. Empty in development = the local dev origins.
PUBLIC_ORIGINS=
# Where the links in e-mails point.
PUBLIC_BASE_URL=http://localhost:3000
# Address of the reverse proxy in front of the API, if any. uvicorn only believes X-Forwarded-For
# from this address; without a proxy leave the default, or every client could spoof its IP.
TRUSTED_PROXY_IPS=127.0.0.1

# Expense attachments: the largest file the API accepts, in bytes (10 MiB by default, 20 MiB at most).
# The directory is ATTACHMENTS_DIR (a docker volume in compose; /attachments when unset).
ATTACHMENT_MAX_BYTES=10485760

# Host ports, bound to 127.0.0.1 only.
DB_HOST_PORT=5435
API_HOST_PORT=8001

# Used ONLY when running the API or its tools on the host (uv), outside Docker. They point to the
# published db port; keep user, password and database in sync with the values above.
# Inside docker compose each service receives its own URLs (host `db`), built from the variables above.
# DATABASE_URL: the application role. DATABASE_ADMIN_URL: the admin, for Alembic, the seed and the
# tests only (never give it to the API process).
DATABASE_URL=postgresql+psycopg://apm_app:change-me-app@127.0.0.1:5435/apm
DATABASE_ADMIN_URL=postgresql+psycopg://apm:change-me@127.0.0.1:5435/apm
